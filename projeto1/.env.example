# =============================================================================
# Projeto 1 — variáveis de ambiente (exemplo SEM credenciais reais)
# Copie para .env.local (desenvolvimento) ou configure no painel da Vercel.
# NENHUMA variável abaixo deve usar o prefixo NEXT_PUBLIC_: todas são do servidor.
# Use credenciais DIFERENTES para desenvolvimento e produção.
# =============================================================================

# --- Inteligência artificial (obrigatório para as conversas funcionarem) -----
AI_PROVIDER=anthropic
# Chave da API Anthropic (console.anthropic.com). Somente no servidor.
ANTHROPIC_API_KEY=
# Modelo (padrão: claude-opus-5-5). Esforço: low | medium | high.
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_MS=90000
# Conversation Guard: modelo do classificador (padrão = AI_MODEL) e tempo limite.
AI_GUARD_MODEL=
AI_GUARD_TIMEOUT_MS=12000
# Fallback server-side da Anthropic quando o modelo recusa por política.
AI_REFUSAL_FALLBACK=true

# --- Banco de dados (PostgreSQL / Supabase) ----------------------------------
# Sem DATABASE_URL a aplicação usa armazenamento EM MEMÓRIA (apenas dev/1 instância).
# Aplicação: use o papel de menor privilégio projeto1_app (criado pela migração 0002).
DATABASE_URL=
# Migrações e seed: usuário com permissão de DDL (ex.: postgres do Supabase). NÃO usar na aplicação.
DATABASE_ADMIN_URL=
# disable | require | verify-full  (produção: verify-full com DATABASE_CA_CERT)
DATABASE_SSL=require
DATABASE_CA_CERT=

# --- Segurança ----------------------------------------------------------------
# Segredo aleatório (>= 32 caracteres) para HMAC. Obrigatório em produção.
# Gere com: openssl rand -hex 32
APP_SECRET=
# Origens extras autorizadas a chamar a API (a própria origem já é permitida).
ALLOWED_ORIGINS=
# true na Vercel (confia em X-Forwarded-For para limites por IP).
TRUST_PROXY=false
# Segredo do endpoint de expurgo agendado (Vercel Cron). >= 32 caracteres.
CRON_SECRET=

# --- Limites de consumo ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=120
GLOBAL_DAILY_MESSAGE_CAP=5000
MAX_MESSAGES_PER_SESSION=60

# --- Privacidade -----------------------------------------------------------------
# Horas até a conversa ser apagada automaticamente (1 a 2160).
CONVERSATION_RETENTION_HOURS=24

# Somente para demonstração local com `next start` sem banco. NÃO usar em produção real.
ALLOW_IN_MEMORY_STORE=false
